---
import '../styles/global.css';
import serifLatin from '../fonts/instrument-serif-latin.woff2?url';
import monaLatin from '../fonts/mona-sans-latin.woff2?url';
import { url } from '../lib/assets';

interface Props {
  title: string;
  description: string;
  ogImage?: string;
  current?: 'inicio' | 'trabajo' | 'sobre';
  /** El teléfono solo aparece en Sobre mí. */
  phone?: boolean;
}
const { title, description, ogImage, current, phone = false } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site);
const og = ogImage ? new URL(ogImage, Astro.site).href : new URL(url('og.jpg'), Astro.site).href;
const person = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: 'María Javiera Molin',
  alternateName: ['Javi Molin', 'Javiera Molin'],
  jobTitle: 'Diseñadora Integral',
  alumniOf: 'Pontificia Universidad Católica de Chile',
  address: { '@type': 'PostalAddress', addressLocality: 'Santiago', addressCountry: 'CL' },
  email: 'mailto:javimolin@gmail.com',
  url: new URL(url(''), Astro.site).href,
  sameAs: ['https://www.linkedin.com/in/javimolin/'],
};
---
<!doctype html>
<html lang="es-CL">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href={url('favicon.svg')} type="image/svg+xml" />
    <link rel="sitemap" href={url('sitemap-index.xml')} />
    <link rel="preload" href={serifLatin} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={monaLatin} as="font" type="font/woff2" crossorigin />
    <meta name="theme-color" content="#ffffff" />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="es_CL" />
    <meta property="og:site_name" content="Javi Molin" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={og} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="author" content="María Javiera Molin" />
    <script type="application/ld+json" set:html={JSON.stringify(person)} />
  </head>
  <body>
    <a class="skip" href="#contenido">Saltar al contenido</a>
    <header class="bar wrap">
      <a class="bar__name" href={url('')} aria-current={current === 'inicio' ? 'page' : undefined}>Javi Molin</a>
      <nav aria-label="Principal">
        <ul>
          <li><a href={url('#trabajo')} aria-current={current === 'trabajo' ? 'page' : undefined}>Proyectos</a></li>
          <li><a href={url('sobre-mi/')} aria-current={current === 'sobre' ? 'page' : undefined}>Sobre mí</a></li>
          <li><a class="bar__cta" href="#contacto">Contacto</a></li>
        </ul>
      </nav>
    </header>
    <main id="contenido">
      <slot />
    </main>
    <footer class="foot wrap" id="contacto">
      <div class="foot__grid">
        <div>
          <h2 class="foot__title h2">Conversemos</h2>
          <p class="foot__text muted">Busco un rol in-house y tomo proyectos freelance desde Santiago. Escríbeme y te respondo pronto.</p>
        </div>
        <div class="foot__actions">
          <div class="actions">
            <a class="btn" href="mailto:javimolin@gmail.com">Escribir un correo</a>
            <a class="btn btn--ghost" href={url('cv/CV-Javi-Molin.pdf')} download>Descargar CV</a>
          </div>
          <ul class="foot__links">
            <li><a href="mailto:javimolin@gmail.com">javimolin@gmail.com</a></li>
            <li><a href="https://www.linkedin.com/in/javimolin/" rel="me">LinkedIn</a></li>
            {phone && <li><a href="tel:+56966303974">+56 9 6630 3974</a></li>}
          </ul>
        </div>
      </div>
      <p class="foot__legal small muted">María Javiera Molin, Diseñadora Integral UC. Las fotos de modelos y producto son material de las marcas; el diseño, la composición y los originales son míos, salvo donde se indica otra autoría.</p>
    </footer>
  </body>
</html>

<style>
  .bar {
    position: sticky; top: 0; z-index: 20;
    display: flex; justify-content: space-between; align-items: center; gap: var(--s-4);
    min-height: 4rem;
    background: rgb(255 255 255 / 0.94);
    backdrop-filter: blur(8px);
    -webkit-backdrop-filter: blur(8px);
  }
  .bar a { text-decoration: none; }
  .bar__name { font-family: var(--display); font-size: 1.375rem; line-height: 1; view-transition-name: sitename; }
  .bar ul { font-size: 0.875rem; }
  .bar ul { display: flex; align-items: center; gap: clamp(1.25rem, 2.6vw, 2.25rem); }
  .bar li a { display: inline-block; padding-block: var(--s-2); color: var(--fg-2); transition: color 160ms ease; }
  .bar li a:hover, .bar li a[aria-current='page'] { color: var(--fg); }

  .bar li a.bar__cta { color: var(--fg); border: 1px solid #cfcfca; border-radius: 6px; padding: 0.375rem 0.875rem; transition: border-color 160ms ease; }
  .bar li a.bar__cta:hover { border-color: var(--ink); }

  .foot { margin-top: var(--section); padding-block: var(--s-8) var(--s-6); border-top: 1px solid var(--rule); }
  .foot__grid { display: grid; grid-template-columns: minmax(0, 7fr) minmax(0, 5fr); gap: var(--s-6) var(--gap); align-items: end; }
  .foot__text { margin-top: var(--s-3); max-width: 40ch; }
  .foot__links { display: flex; flex-wrap: wrap; gap: var(--s-1) var(--s-5); margin-top: var(--s-4); font-size: var(--t-small); }
  .foot__links a { color: var(--fg-2); }
  .foot__legal { margin-top: var(--s-8); max-width: 70ch; }
  @media (max-width: 899px) { .foot__grid { grid-template-columns: 1fr; } }

  @media (max-width: 520px) {
    .bar ul { gap: 0.875rem; font-size: 0.875rem; }
    .bar__name { font-size: 1.1875rem; }
  }
</style>
