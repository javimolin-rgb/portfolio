---
/* Piezas alineadas en una base común con su medida real.
   --k es la cantidad de píxeles por centímetro: se ajusta al ancho disponible,
   con un mínimo para que en móvil la fila se recorra horizontalmente. */
import Figure from './Figure.astro';
import type { Piece } from '../data/projects';
import { url } from '../lib/assets';

interface Props { pieces: { piece: Piece; project?: string; title?: string }[]; maxH?: number; label?: string }
const { pieces, maxH = 380, label = 'Piezas a escala' } = Astro.props;
const sumW = pieces.reduce((a, p) => a + p.piece.cm![0], 0);
const maxCm = Math.max(...pieces.map((p) => p.piece.cm![1]));
const gaps = pieces.length - 1;
---
<div class="scale" style={`--sum:${sumW};--maxcm:${maxCm};--gaps:${gaps};--maxh:${maxH}px`}>
  <ul class="scale__row" aria-label={label} tabindex="0">
    {pieces.map(({ piece, project, title }) => (
      <li class="scale__item" style={`--cw:${piece.cm![0]};--ch:${piece.cm![1]}`}>
        <div class="scale__piece">
          <Figure piece={piece} caption={false} sizes="(min-width: 1100px) 40vw, 70vw" widths={[400, 800, 1600]} />
        </div>
        <p class="cap">
          <b>{piece.name}</b>
          <span>{piece.format}</span>
          {project && <a href={url(`trabajo/${project}/`)}>{title}</a>}
        </p>
      </li>
    ))}
  </ul>
</div>

<style>
  .scale { container-type: inline-size; }
  .scale__row {
    --col: 6rem;
    --k: max(0.62px, min(calc((100cqw - var(--gaps) * 1.25rem - 20rem) / var(--sum)), calc(var(--maxh) / var(--maxcm))));
    display: flex; align-items: flex-end; gap: 1.25rem;
    overflow-x: auto; overscroll-behavior-x: contain;
    padding-bottom: var(--s-3);
    scrollbar-width: thin; scrollbar-color: var(--fg) transparent;
  }
  .scale__item { flex: none; display: flex; flex-direction: column; justify-content: flex-end; min-width: min(var(--col), max(4.5rem, calc(var(--k) * var(--cw)))); }
  .scale__piece {
    width: calc(var(--k) * var(--cw));
    height: calc(var(--k) * var(--ch));
    border-bottom: 2px solid var(--fg);
  }
  .scale__item { position: relative; }
  .scale__piece :global(.fig), .scale__piece :global(.fig__media) { width: 100%; height: 100%; aspect-ratio: auto; }
  .scale__piece :global(img) { width: 100%; height: 100%; object-fit: contain; object-position: 50% 100%; }
  .scale__item .cap { margin-top: var(--s-3); min-height: 5.8em; }
  .scale__item .cap a { display: inline-block; margin-top: var(--s-1); }
  .scale__row:focus-visible { outline-offset: 6px; }
</style>
