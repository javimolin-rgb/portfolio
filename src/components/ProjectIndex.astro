---
/* Índice tipográfico. Cada título tiene el ancho de su formato emblemático.
   Al pasar el mouse o enfocar, la página toma el color de la campaña. */
import Figure from './Figure.astro';
import { projects, stretchFor, type Piece, type Project } from '../data/projects';
import { url } from '../lib/assets';

const thumbs = (p: Project): Piece[] => {
  const out: Piece[] = [p.cover];
  for (const b of p.blocks) {
    const ps = 'pieces' in b && b.pieces ? b.pieces : b.kind === 'pair' ? [b.a, b.b] : [];
    for (const x of ps) if (!out.some((o) => o.ref === x.ref) && !x.video) out.push(x);
    if (out.length >= 3) break;
  }
  return out.slice(0, 3);
};
// Ancho medio de un carácter de Anybody, en em, según el ancho de la fuente.
const emPerChar = (s: number) => 0.08 + 0.0048 * s;
---
<section id="trabajo" class="work" aria-labelledby="work-title">
  <div class="work__head wrap">
    <h2 id="work-title" class="h2">Trabajo</h2>
    <p class="work__intro muted">Diez proyectos de 2025: eventos, campañas, lanzamientos y piezas de tienda. Cada uno con el color de su temporada.</p>
  </div>
  <ul class="index" data-index>
    {projects.map((p) => {
      const st = stretchFor(p.format.ratio);
      const lines = p.lines ?? [p.title];
      const longest = Math.max(...lines.map((l) => l.length));
      const fit = `calc(min(var(--t-index), calc(97cqw / ${(longest * emPerChar(st)).toFixed(2)})) * var(--k, 1))`;
      return (
        <li class="row">
          <a
            class="row__link wrap"
            href={url(`trabajo/${p.slug}/`)}
            data-field={p.field}
            data-ink={p.ink}
            style={`--stretch:${st}%`}
          >
            <span class="row__tbox">
              <span class="row__title display" data-fit style={`font-size:${fit};view-transition-name: t-${p.slug}`}>
                {lines.map((l) => <span class="row__line">{l}</span>)}
              </span>
            </span>
            <span class="row__aside">
              <span class="row__meta small">
                <span class="row__client">{p.client}</span>
                <span class="row__kind">{p.status ?? p.formats.slice(0, 3).join(', ')}</span>
              </span>
              <span class="row__strip" aria-hidden="true">
                {thumbs(p).map((t) => (
                  <Figure piece={t} caption={false} sizes="12rem" widths={[400]} />
                ))}
              </span>
            </span>
          </a>
        </li>
      );
    })}
  </ul>
</section>

<style>
  .work { padding-top: var(--section); }
  .work__head { display: grid; grid-template-columns: minmax(0, 8fr) minmax(0, 4fr); gap: var(--gap); align-items: end; padding-bottom: var(--s-6); }
  .work__intro { max-width: 40ch; }

  .index { border-top: 1px solid var(--rule); }
  .row { border-bottom: 1px solid var(--rule); }
  .row__link {
    display: grid;
    grid-template-columns: minmax(0, 8fr) minmax(0, 4fr);
    gap: var(--s-4) calc(var(--gap) * 2);
    align-items: end;
    padding-block: clamp(1.25rem, 2.4vw, 2rem);
    text-decoration: none;
  }
  .row__tbox { container-type: inline-size; min-width: 0; }
  .row__title { display: inline-block; font-weight: 780; line-height: 0.9; white-space: nowrap; }
  .row__line { display: block; }
  .row__aside { display: flex; flex-direction: column; gap: var(--s-4); min-width: 0; }
  .row__meta { display: flex; flex-direction: column; gap: var(--s-1); max-width: 36ch; }
  .row__client { font-weight: 620; }
  .row__kind { color: var(--fg-2); }

  .row__strip { display: flex; gap: var(--s-2); align-items: flex-end; height: clamp(4.5rem, 7vw, 7rem); overflow: hidden; }
  .row__strip :global(.fig) { height: 100%; flex: none; }
  .row__strip :global(.fig__media) { height: 100%; width: auto; aspect-ratio: var(--r); }
  .row__strip :global(img) { width: auto; height: 100%; }
  .row__strip :global(.fig) { transition: transform 240ms var(--ease-out); }
  @media (hover: hover) and (pointer: fine) {
    .row__link:hover .row__strip :global(.fig) { transform: translateY(-0.25rem); }
    .row__link:hover .row__strip :global(.fig:nth-child(2)) { transition-delay: 30ms; }
    .row__link:hover .row__strip :global(.fig:nth-child(3)) { transition-delay: 60ms; }
  }

  @media (max-width: 899px) {
    .work__head { grid-template-columns: 1fr; }
    .row__link { grid-template-columns: 1fr; }
  }
</style>

<script>
  // Color de temporada: la página adopta el campo y la tinta del proyecto activo.
  const list = document.querySelector<HTMLElement>('[data-index]');
  const fine = window.matchMedia('(hover: hover) and (pointer: fine)').matches;
  if (list) {
    const html = document.documentElement;
    const meta = document.querySelector<HTMLMetaElement>('meta[name="theme-color"]');
    const base = meta?.content;
    const set = (a?: HTMLElement) => {
      if (a) {
        html.style.setProperty('--bg', a.dataset.field!);
        html.style.setProperty('--fg', a.dataset.ink!);
        html.style.setProperty('--fg-2', a.dataset.ink!);
        html.style.setProperty('--rule', `color-mix(in srgb, ${a.dataset.ink} 28%, transparent)`);
        if (meta) meta.content = a.dataset.field!;
      } else {
        ['--bg', '--fg', '--fg-2', '--rule'].forEach((p) => html.style.removeProperty(p));
        if (meta && base) meta.content = base;
      }
    };
    list.querySelectorAll<HTMLAnchorElement>('.row__link').forEach((a) => {
      if (fine) a.addEventListener('pointerenter', () => set(a));
      a.addEventListener('focus', () => set(a));
      a.addEventListener('blur', () => set());
    });
    if (fine) list.addEventListener('pointerleave', () => set());
    window.addEventListener('pageshow', () => set());

  }
</script>
