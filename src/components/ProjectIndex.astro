---
/* Índice de proyectos: grilla de dos columnas con la portada de cada caso sobre una placa neutra.
   Las piezas gráficas se ven completas (contain); las fotos de montaje llenan la placa (cover). */
import { Picture } from 'astro:assets';
import { projects } from '../data/projects';
import { asset, url } from '../lib/assets';

const items = projects.map((p) => {
  const img = asset(p.cover.ref);
  const photo = Boolean(p.cover.focus) || /foto/i.test(p.cover.format ?? '');
  return { p, img, photo };
});
---
<section id="trabajo" class="work wrap" aria-labelledby="work-title">
  <div class="work__head">
    <h2 id="work-title" class="h2">Proyectos</h2>
    <p class="work__intro muted">Diez proyectos de 2025: eventos, campañas, lanzamientos y piezas de tienda.</p>
  </div>
  <ul class="grid">
    {items.map(({ p, img, photo }, i) => (
      <li>
        <a class="card" href={url(`trabajo/${p.slug}/`)}>
          <span class:list={['card__plate', { 'card__plate--photo': photo }]}>
            <Picture
              class="card__img"
              src={img}
              alt=""
              widths={[480, 800, 1200].filter((w) => w <= img.width)}
              sizes="(min-width: 900px) 46vw, 92vw"
              formats={['avif']}
              fallbackFormat="webp"
              loading={i < 2 ? 'eager' : 'lazy'}
              style={photo ? `object-position:${p.cover.focus ?? '50% 50%'}` : undefined}
            />
          </span>
          <span class="card__text">
            <span class="card__title" style={`view-transition-name: t-${p.slug}`}>{p.title}</span>
            <span class="card__meta">{p.category}. {p.client}, {p.year}</span>
          </span>
        </a>
      </li>
    ))}
  </ul>
</section>

<style>
  .work { padding-top: var(--section); }
  .work__head { display: flex; flex-wrap: wrap; justify-content: space-between; align-items: baseline; gap: var(--s-3) var(--s-6); padding-bottom: var(--s-6); }
  .work__intro { font-size: var(--t-small); }

  .grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: clamp(2.5rem, 5vw, 4.5rem) var(--gap); }
  .card { display: block; text-decoration: none; }
  .card__plate {
    display: block; aspect-ratio: 4 / 3; overflow: hidden;
    background: var(--plate);
    padding: clamp(1.25rem, 3.5vw, 3rem);
  }
  .card__plate--photo { padding: 0; }
  .card__plate :global(img) {
    width: 100%; height: 100%; object-fit: contain;
    transition: transform 600ms var(--ease-out);
  }
  .card__plate--photo :global(img) { object-fit: cover; }
  .card__text { display: flex; flex-direction: column; gap: var(--s-1); margin-top: var(--s-4); }
  .card__title { font-family: var(--display); font-size: clamp(1.5rem, 1.25rem + 0.8vw, 2rem); line-height: 1.1; letter-spacing: -0.005em; }
  .card__meta { font-size: var(--t-small); color: var(--fg-2); }

  @media (hover: hover) and (pointer: fine) {
    .card:hover .card__plate :global(img) { transform: scale(1.02); }
    .card:hover .card__title { text-decoration: underline; text-decoration-thickness: 1px; text-underline-offset: 0.25em; }
  }

  @media (max-width: 699px) {
    .grid { grid-template-columns: 1fr; }
  }
</style>
