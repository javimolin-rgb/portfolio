---
/* El momento firma: una pieza real cambia de formato dentro de un mismo marco. */
import { Picture } from 'astro:assets';
import { formatsReel, projects } from '../data/projects';
import { asset, url } from '../lib/assets';

const reel = formatsReel.map((f, i) => {
  const img = asset(f.piece.ref);
  const project = projects.find((p) => p.slug === f.project)!;
  return { ...f, img, i, project };
});
const first = reel[0];
---
<section class="hero wrap" aria-labelledby="hero-name" data-frame>
  <div class="hero__text">
    <h1 id="hero-name" class="hero__name display">Javi Molin</h1>
    <div class="hero__body">
      <p class="hero__role">Diseñadora gráfica, campañas y branding</p>
      <p class="hero__intro lead">
        Diseñadora Integral UC. Campañas, eventos y piezas de tienda para marcas en Chile y Perú, pensadas para funcionar igual en un pendón de dos metros que en un mensaje de WhatsApp.
      </p>
      <div class="actions hero__actions">
        <a class="btn" href="#trabajo">Ver proyectos</a>
        <a class="btn btn--ghost" href={url('cv/CV-Javi-Molin.pdf')} download>Descargar CV</a>
      </div>
    </div>
  </div>

  <div class="hero__stage">
    <p class="frame__label small muted">Una idea, seis formatos</p>
    <div class="frame" data-stage>
      <div class="frame__inner">
      <div class="frame__box" data-box style={`--ratio:${first.ratio}`}>
        {reel.map((r) => (
          <Picture
            class:list={['frame__img', { 'is-on': r.i === 0, 'is-round': r.piece.round }]}
            src={r.img}
            alt={`${r.piece.name}, ${r.piece.format}. Proyecto ${r.project.title}.`}
            widths={[500, 900, 1400].filter((w) => w <= r.img.width)}
            sizes="(min-width: 900px) 36vw, 90vw"
            formats={['avif']}
            fallbackFormat="webp"
            loading={r.i === 0 ? 'eager' : 'lazy'}
            fetchpriority={r.i === 0 ? 'high' : undefined}
            data-i={r.i}
            aria-hidden={r.i === 0 ? undefined : 'true'}
          />
        ))}
      </div>
      </div>
    </div>

    <div class="frame__meta">
      <p class="frame__now" aria-live="polite">
        <span><b data-now-name>{first.piece.name}</b>, <span data-now-format>{first.piece.format}</span></span>
        <a data-now-link href={url(`trabajo/${first.project.slug}/`)}>{first.project.title}</a>
      </p>
      <div class="frame__controls" role="group" aria-label="Elegir formato">
        {reel.map((r) => (
          <button
            type="button"
            class="frame__btn"
            aria-pressed={r.i === 0 ? 'true' : 'false'}
            data-go={r.i}
            data-ratio={r.ratio}
            data-name={r.piece.name}
            data-format={r.piece.format}
            data-href={url(`trabajo/${r.project.slug}/`)}
            data-project={r.project.title}
            data-round={r.piece.round ? '1' : ''}
          ><span class="sr-only">{r.piece.name}</span></button>
        ))}
        <button type="button" class="frame__pause" data-pause aria-pressed="false">Pausar</button>
      </div>
    </div>
  </div>
</section>

<style>
  .hero {
    display: grid;
    grid-template-columns: minmax(0, 7fr) minmax(0, 5fr);
    gap: var(--s-7) clamp(2rem, 6vw, 7rem);
    align-items: start;
    padding-top: clamp(3rem, 10vh, 7rem);
  }
  .hero__text { display: flex; flex-direction: column; justify-content: center; gap: var(--s-6); align-self: stretch; padding-bottom: var(--s-6); }
  .hero__name { font-size: var(--t-hero); line-height: 0.95; letter-spacing: -0.02em; }
  .hero__body { display: grid; gap: var(--s-4); }
  .hero__role { font-weight: 500; }
  .hero__actions { margin-top: var(--s-2); }
  .hero__intro { max-width: 36ch; color: var(--fg-2); }

  .hero__stage { display: flex; flex-direction: column; gap: var(--s-4); min-width: 0; }
  .frame { position: relative; aspect-ratio: 4 / 5; max-height: 70svh; background: var(--plate); padding: clamp(1.5rem, 3vw, 2.75rem); }
  .frame__inner { position: relative; width: 100%; height: 100%; container-type: size; display: grid; place-items: center; }
  .frame__box {
    position: relative;
    width: min(100cqw, calc(100cqh * var(--ratio)));
    height: min(100cqh, calc(100cqw / var(--ratio)));
    transition: width 700ms var(--ease-in-out), height 700ms var(--ease-in-out);
  }
  :global(.frame__img) { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; opacity: 0; transition: opacity 420ms ease; }
  :global(.frame__img.is-on) { opacity: 1; }
  :global(.frame__img.is-round) { border-radius: 50%; }

  .frame__label { margin-bottom: calc(var(--s-1) * -1); }
  .frame__now { display: flex; flex-wrap: wrap; justify-content: space-between; align-items: baseline; gap: 0 var(--s-3); font-size: var(--t-small); line-height: 1.4; }
  .frame__now b { font-weight: 500; }
  .frame__now span span { color: var(--fg-2); }
  .frame__controls { display: flex; align-items: center; gap: var(--s-1); }
  .frame__btn { flex: 1; min-height: 32px; position: relative; }
  .frame__btn::after { content: ''; position: absolute; left: 0; right: 0; top: 50%; height: 2px; background: var(--rule); transition: background-color 200ms ease; }
  .frame__btn:hover::after { background: #bdbdb7; }
  .frame__btn[aria-pressed='true']::after { background: var(--ink); }
  .frame__pause { margin-left: var(--s-3); min-height: 32px; font-size: var(--t-small); color: var(--fg-2); }
  .frame__pause:hover { color: var(--fg); }

  @media (max-width: 899px) {
    .hero { grid-template-columns: 1fr; gap: var(--s-7); }
    .frame { aspect-ratio: 1 / 1; max-height: none; }
  }
  @media (max-width: 599px) {
    .frame__now a { margin-left: 0; flex-basis: 100%; }
  }
</style>

<script>
  const root = document.querySelector<HTMLElement>('[data-frame]');
  if (root) {
    const box = root.querySelector<HTMLElement>('[data-box]')!;
    const imgs = Array.from(box.querySelectorAll<HTMLElement>('.frame__img'));
    const btns = Array.from(root.querySelectorAll<HTMLButtonElement>('[data-go]'));
    const pauseBtn = root.querySelector<HTMLButtonElement>('[data-pause]')!;
    const nowName = root.querySelector('[data-now-name]')!;
    const nowFormat = root.querySelector('[data-now-format]')!;
    const nowLink = root.querySelector<HTMLAnchorElement>('[data-now-link]')!;
    const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    let current = 0;
    let userPaused = reduce;
    let hovering = false;
    let visible = true;
    let timer: number | undefined;

    const show = (i: number) => {
      current = (i + btns.length) % btns.length;
      const b = btns[current];
      box.style.setProperty('--ratio', b.dataset.ratio!);
      imgs.forEach((img, k) => {
        img.classList.toggle('is-on', k === current);
        if (k === current) img.removeAttribute('aria-hidden'); else img.setAttribute('aria-hidden', 'true');
        const el = img.tagName === 'PICTURE' ? img.querySelector('img') : img;
        if (el && k === current) el.setAttribute('loading', 'eager');
      });
      btns.forEach((x, k) => x.setAttribute('aria-pressed', String(k === current)));
      nowName.textContent = b.dataset.name!;
      nowFormat.textContent = b.dataset.format!;
      nowLink.textContent = b.dataset.project!;
      nowLink.href = b.dataset.href!;
    };

    const schedule = () => {
      window.clearTimeout(timer);
      if (userPaused || hovering || !visible) return;
      timer = window.setTimeout(() => { show(current + 1); schedule(); }, 3200);
    };

    btns.forEach((b, k) => b.addEventListener('click', () => { show(k); schedule(); }));
    pauseBtn.addEventListener('click', () => {
      userPaused = !userPaused;
      pauseBtn.setAttribute('aria-pressed', String(userPaused));
      pauseBtn.textContent = userPaused ? 'Reproducir' : 'Pausar';
      schedule();
    });
    if (reduce) { pauseBtn.textContent = 'Reproducir'; pauseBtn.setAttribute('aria-pressed', 'true'); }
    const stage = root.querySelector<HTMLElement>('.hero__stage')!;
    stage.addEventListener('pointerenter', () => { hovering = true; schedule(); });
    stage.addEventListener('pointerleave', () => { hovering = false; schedule(); });
    stage.addEventListener('focusin', () => { hovering = true; schedule(); });
    stage.addEventListener('focusout', () => { hovering = false; schedule(); });
    new IntersectionObserver(([e]) => { visible = e.isIntersecting; schedule(); }, { threshold: 0.2 }).observe(root);
    schedule();
  }
</script>
