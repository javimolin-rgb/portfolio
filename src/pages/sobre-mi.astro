---
import Base from '../layouts/Base.astro';
import { url } from '../lib/assets';

const experiencia = [
  { periodo: '2025', cargo: 'Diseñadora de Marketing', lugar: 'Ripley', detalle: 'Campañas digitales y presenciales en Chile y Perú: Ripley Beauty, Día del Niño, Navidad, CyberDay, Días R, eventos y activaciones.' },
  { periodo: '2022 a hoy', cargo: 'Diseñadora independiente', lugar: 'Freelance', detalle: 'Branding, redes sociales y material gráfico para clientes de distintas industrias.' },
  { periodo: '2022 a 2023', cargo: 'Diseñadora principal', lugar: 'Agencia Lupa BTL', detalle: 'Propuestas de diseño para clientes de capital humano, espacios y vestuario para eventos corporativos, y redes sociales de la agencia.' },
  { periodo: '2022 a 2023', cargo: 'Diseñadora complementaria', lugar: 'Fundación Banco de Ropa', detalle: 'Propuestas para un uso más eficiente de los recursos de la fundación.' },
];
const formacion = [
  { periodo: '2019 a 2024', titulo: 'Diseño Integral, con foco en Diseño Gráfico y Branding', lugar: 'Pontificia Universidad Católica de Chile' },
  { periodo: '2023', titulo: 'Diplomado en Branding y Valor de Marca', lugar: 'Pontificia Universidad Católica de Chile' },
  { periodo: '2024', titulo: 'Certificado Académico en Innovación', lugar: 'Escuela de Ingeniería UC' },
  { periodo: '2024', titulo: 'Marketing con Redes Sociales', lugar: 'Tec de Monterrey' },
  { periodo: '2024', titulo: 'UI/UX Design', lugar: 'CalArts' },
  { periodo: '2020 a 2024', titulo: 'Ayudante de cátedra', lugar: 'Escuela de Diseño UC: Ideación y Formalización, Psicología para el Diseño, Diseño y Economía Circular' },
];
const hace = ['Dirección de arte y key visuals', 'Campañas retail multiformato', 'Eventos, activaciones y gran formato', 'Branding e identidad', 'Redes sociales y e-commerce', 'Motion para pantallas', 'Retoque y fotomontaje', 'Originales para producción'];
const herramientas = ['Illustrator', 'Photoshop', 'InDesign', 'After Effects', 'Premiere', 'Lightroom', 'Figma', 'Procreate', 'HTML', 'Midjourney', 'Firefly'];
---
<Base
  title="Sobre mí — Javi Molin"
  description="María Javiera Molin, Diseñadora Integral UC. Experiencia en Ripley, Agencia Lupa BTL y Fundación Banco de Ropa; formación, herramientas y contacto."
  current="sobre"
  phone
>
  <section class="bio wrap">
    <h1 class="bio__title display">Javiera Molin</h1>
    <div class="bio__cols">
      <p class="lead bio__lead">Diseñadora Integral de la Pontificia Universidad Católica de Chile, con foco en diseño gráfico y branding, y un diplomado en Branding y Valor de Marca.</p>
      <div class="prose">
        <p>En 2025 trabajé como diseñadora de marketing en Ripley. Hice campañas comerciales y eventos para Chile y Perú: piezas para redes, e-commerce, pantallas de Metro, pendones, lienzos de cinco metros, módulos de tienda y merchandising. Trabajé todos los días con los equipos de Marketing, Contenidos y Comercial, y con agencias y productoras.</p>
        <p>Me gusta la parte del proyecto que no se ve en la pieza final: medir, adaptar a veinte formatos, revisar el legal y cerrar originales para que la imprenta no tenga dudas.</p>
        <p>Antes fui diseñadora principal en Agencia Lupa BTL y diseñadora en Fundación Banco de Ropa. Desde 2022 hago proyectos freelance de branding, redes sociales y material gráfico.</p>
        <p>Hoy busco un rol in-house y tomo proyectos freelance, desde Santiago.</p>
      </div>
    </div>
  </section>

  <section class="cv wrap" aria-labelledby="exp">
    <h2 id="exp" class="h2">Experiencia</h2>
    <ol class="cv__list">
      {experiencia.map((e) => (
        <li>
          <p class="cv__when">{e.periodo}</p>
          <div>
            <h3 class="h3">{e.cargo}</h3>
            <p class="cv__where">{e.lugar}</p>
            <p class="cv__what">{e.detalle}</p>
          </div>
        </li>
      ))}
    </ol>
  </section>

  <section class="cv wrap" aria-labelledby="edu">
    <h2 id="edu" class="h2">Formación</h2>
    <ol class="cv__list">
      {formacion.map((f) => (
        <li>
          <p class="cv__when">{f.periodo}</p>
          <div>
            <h3 class="h3">{f.titulo}</h3>
            <p class="cv__where">{f.lugar}</p>
          </div>
        </li>
      ))}
    </ol>
  </section>

  <section class="tools wrap" aria-label="Qué hago y con qué">
    <div>
      <h2 class="h2">Qué hago</h2>
      <ul class="tools__list">{hace.map((h) => <li>{h}</li>)}</ul>
    </div>
    <div>
      <h2 class="h2">Con qué</h2>
      <ul class="tools__list">{herramientas.map((h) => <li>{h}</li>)}</ul>
    </div>
  </section>

</Base>

<style>
  .bio { padding-top: clamp(2rem, 7vh, 5rem); }
  .bio__title { font-size: var(--t-display); --stretch: 118%; font-weight: 800; line-height: 0.86; }
  .bio__cols { display: grid; grid-template-columns: minmax(0, 7fr) minmax(0, 5fr); gap: var(--s-6) calc(var(--gap) * 2); margin-top: clamp(2rem, 5vw, 4rem); }
  .bio__lead { max-width: 30ch; }

  .cv { padding-top: var(--section); }
  .cv__list { margin-top: var(--s-6); border-top: 1px solid var(--rule); }
  .cv__list li { display: grid; grid-template-columns: minmax(0, 3fr) minmax(0, 9fr); gap: var(--gap); padding-block: var(--s-5); border-bottom: 1px solid var(--rule); }
  .cv__when { font-weight: 600; font-variant-numeric: tabular-nums; }
  .cv__where { margin-top: var(--s-1); font-weight: 560; }
  .cv__what { margin-top: var(--s-2); max-width: 60ch; color: var(--fg-2); }

  .tools { padding-top: var(--section); display: grid; grid-template-columns: 1fr 1fr; gap: var(--s-7) calc(var(--gap) * 2); }
  .tools__list { margin-top: var(--s-5); display: flex; flex-wrap: wrap; gap: var(--s-2) var(--s-5); font-size: var(--t-lead); line-height: 1.3; }

  @media (max-width: 899px) {
    .bio__cols, .tools { grid-template-columns: 1fr; }
    .cv__list li { grid-template-columns: 1fr; gap: var(--s-2); }
  }
</style>
