---
import { getImage } from 'astro:assets';
import Base from '../../layouts/Base.astro';
import Figure from '../../components/Figure.astro';
import Blocks from '../../components/Blocks.astro';
import { projects, type Project } from '../../data/projects';
import { asset, url } from '../../lib/assets';

export function getStaticPaths() {
  return projects.map((p, i) => ({ params: { slug: p.slug }, props: { project: p, prev: projects[(i - 1 + projects.length) % projects.length], next: projects[(i + 1) % projects.length] } }));
}
interface Props { project: Project; prev: Project; next: Project }
const { project: p, prev, next } = Astro.props;

const og = await getImage({ src: asset(p.cover.ref), width: 1200, height: 630, fit: 'cover', format: 'jpg', quality: 82 });
---
<Base
  title={`${p.title} — Javi Molin`}
  description={p.summary}
  ogImage={og.src}
  current="trabajo"
>
  <article class="case">
    <header class="case__head">
      <div class="wrap">
        <p class="case__back small"><a href={url('#trabajo')}>Todos los proyectos</a></p>
        <h1 class="case__title display" style={`view-transition-name:t-${p.slug}`}>{p.title}</h1>
        <div class="case__intro">
          <p class="lead case__lead">{p.summary}</p>
          <dl class="case__meta">
            <div><dt>Tipo</dt><dd>{p.category}</dd></div>
            <div><dt>Cliente</dt><dd>{p.client}</dd></div>
            <div><dt>Año</dt><dd>{p.year}</dd></div>
            <div><dt>Rol</dt><dd>{p.role}</dd></div>
            <div><dt>Formatos</dt><dd>{p.formats.join(', ')}</dd></div>
            {p.status && <div><dt>Estado</dt><dd>{p.status}</dd></div>}
          </dl>
        </div>
      </div>
    </header>

    {p.hero.mode === 'bleed' ? (
      <section class="case__hero case__hero--bleed wrap">
        <Figure piece={p.hero.piece} fit="cover" eager sizes="100vw" caption={false} />
        <p class="cap"><b>{p.hero.piece.name}</b>{p.hero.piece.format && <span>{p.hero.piece.format}</span>}</p>
      </section>
    ) : (
      <section class="case__hero case__hero--piece wrap">
        <div class="case__plate">
          <Figure piece={p.hero.piece} eager sizes="(min-width: 1100px) 70vw, 100vw" />
        </div>
      </section>
    )}

    <Blocks blocks={p.blocks} />

    {p.credits && (
      <section class="case__credits">
        <div class="wrap">
          <h2 class="h3">Créditos</h2>
          <ul>{p.credits.map((c) => <li>{c}</li>)}</ul>
        </div>
      </section>
    )}
  </article>

  <nav class="pager wrap" aria-label="Otros proyectos">
    <a class="pager__link" href={url(`trabajo/${prev.slug}/`)}>
      <span class="small muted">Anterior</span>
      <span class="pager__title display">{prev.title}</span>
    </a>
    <a class="btn btn--ghost pager__all" href={url('#trabajo')}>Todos los proyectos</a>
    <a class="pager__link pager__link--next" href={url(`trabajo/${next.slug}/`)}>
      <span class="small muted">Siguiente</span>
      <span class="pager__title display">{next.title}</span>
    </a>
  </nav>
</Base>

<style>
  .case__head { padding-top: clamp(2.5rem, 8vh, 5.5rem); padding-bottom: clamp(2.5rem, 5vw, 4rem); }
  .case__back a { color: var(--fg-2); text-decoration: none; }
  .case__back a:hover { color: var(--fg); }
  .case__title { margin-top: var(--s-4); font-size: var(--t-display); max-width: 18ch; }
  .case__intro { display: grid; grid-template-columns: minmax(0, 7fr) minmax(0, 5fr); gap: var(--s-6) var(--gap); margin-top: clamp(2rem, 4vw, 3rem); align-items: start; }
  .case__lead { max-width: 40ch; }
  .case__meta { display: grid; gap: 0; font-size: var(--t-small); border-top: 1px solid var(--rule); }
  .case__meta div { display: grid; grid-template-columns: 6rem 1fr; gap: var(--s-3); padding-block: var(--s-3); border-bottom: 1px solid var(--rule); }
  .case__meta dt { color: var(--fg-2); }

  .case__hero--bleed :global(.fig__media) { aspect-ratio: auto; height: min(80svh, 56rem); }
  .case__plate { background: var(--plate); padding: clamp(1.5rem, 5vw, 5rem); }
  .case__plate :global(.fig) { max-width: min(100%, calc(70svh * var(--r))); margin-inline: auto; }

  .case__credits { padding-top: var(--section); font-size: var(--t-small); }
  .case__credits .wrap { max-width: none; }
  .case__credits ul { margin-top: var(--s-3); display: grid; gap: var(--s-1); color: var(--fg-2); }

  .pager { margin-top: var(--section); display: grid; grid-template-columns: 1fr auto 1fr; gap: var(--s-5); align-items: center; }
  .pager__link { display: grid; gap: var(--s-1); padding-top: var(--s-5); border-top: 1px solid var(--rule); text-decoration: none; align-self: stretch; }
  .pager__link--next { text-align: right; }
  .pager__title { font-size: clamp(1.5rem, 1.2rem + 1vw, 2.125rem); }
  .pager__link:hover .pager__title { text-decoration: underline; text-decoration-thickness: 1px; text-underline-offset: 0.18em; }
  @media (max-width: 699px) {
    .pager { grid-template-columns: 1fr 1fr; }
    .pager__all { grid-column: 1 / -1; grid-row: 2; }
  }

  @media (max-width: 899px) {
    .case__intro { grid-template-columns: 1fr; }
  }
</style>
