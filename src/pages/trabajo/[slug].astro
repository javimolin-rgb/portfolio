---
import { getImage } from 'astro:assets';
import Base from '../../layouts/Base.astro';
import Figure from '../../components/Figure.astro';
import Blocks from '../../components/Blocks.astro';
import { projects, stretchFor, type Project } from '../../data/projects';
import { asset, url } from '../../lib/assets';

export function getStaticPaths() {
  return projects.map((p, i) => ({ params: { slug: p.slug }, props: { project: p, next: projects[(i + 1) % projects.length] } }));
}
interface Props { project: Project; next: Project }
const { project: p, next } = Astro.props;

const og = await getImage({ src: asset(p.cover.ref), width: 1200, height: 630, fit: 'cover', format: 'jpg', quality: 82 });
const heroSurface = p.hero.surface ?? 'field';
const articleStyle = `--p-field:${p.field};--p-ink:${p.ink};--p-alt-bg:${p.alt?.bg ?? p.field};--p-alt-ink:${p.alt?.ink ?? p.ink};`;
const lines = p.lines ?? [p.title];
---
<Base
  title={`${p.title} — Javi Molin`}
  description={p.summary}
  ogImage={og.src}
  bg={p.field}
  fg={p.ink}
  current="trabajo"
>
  <article class="case" style={articleStyle}>
    <header class="case__head s-field">
      <div class="wrap">
        <h1 class="case__title display" data-fit style={`--stretch:${stretchFor(p.format.ratio)}%;view-transition-name:t-${p.slug}`}>
          {lines.map((l) => <span>{l}</span>)}
        </h1>
        <div class="case__intro">
          <p class="lead case__lead">{p.summary}</p>
          <dl class="case__meta">
            <div><dt>Cliente</dt><dd>{p.client}</dd></div>
            <div><dt>Año</dt><dd>{p.year}</dd></div>
            <div><dt>Rol</dt><dd>{p.role}</dd></div>
            <div><dt>Formatos</dt><dd>{p.formats.join(', ')}</dd></div>
            {p.status && <div><dt>Estado</dt><dd>{p.status}</dd></div>}
          </dl>
        </div>
      </div>
    </header>

    {p.hero.mode === 'bleed' ? (
      <section class="case__hero case__hero--bleed s-field">
        <Figure piece={p.hero.piece} fit="cover" eager sizes="100vw" caption={false} />
        <p class="cap wrap"><b>{p.hero.piece.name}</b>{p.hero.piece.format && <span>{p.hero.piece.format}</span>}</p>
      </section>
    ) : (
      <section class={`case__hero case__hero--piece s-${heroSurface}`}>
        <div class="wrap">
          <Figure piece={p.hero.piece} eager sizes="(min-width: 1100px) 70vw, 100vw" />
        </div>
      </section>
    )}

    <Blocks blocks={p.blocks} />

    {p.credits && (
      <section class="case__credits s-field">
        <div class="wrap">
          <h2 class="h3">Créditos</h2>
          <ul>{p.credits.map((c) => <li>{c}</li>)}</ul>
        </div>
      </section>
    )}
  </article>

  <nav class="next" aria-label="Siguiente proyecto" style={`--nf:${next.field};--ni:${next.ink}`}>
    <a class="next__link wrap" href={url(`trabajo/${next.slug}/`)}>
      <span class="next__label">Siguiente proyecto</span>
      <span class="next__title display" data-fit style={`--stretch:${stretchFor(next.format.ratio)}%;view-transition-name:t-${next.slug}`}>
        {(next.lines ?? [next.title]).map((l) => <span>{l}</span>)}
      </span>
    </a>
  </nav>
</Base>

<style>
  .case__head { background: var(--bg); color: var(--fg); padding-top: clamp(2rem, 7vh, 5rem); padding-bottom: clamp(2.5rem, 6vw, 5rem); }
  .case__title { display: inline-block; white-space: nowrap; font-size: calc(var(--t-display) * var(--k, 1)); font-weight: 800; line-height: 0.86; letter-spacing: -0.025em; }
  .case__title span { display: block; }
  .case__intro { display: grid; grid-template-columns: minmax(0, 7fr) minmax(0, 5fr); gap: var(--s-6) calc(var(--gap) * 2); margin-top: clamp(2rem, 5vw, 4rem); align-items: start; }
  .case__lead { max-width: 36ch; }
  .case__meta { display: grid; gap: var(--s-3); font-size: var(--t-small); }
  .case__meta div { display: grid; grid-template-columns: 6.5rem 1fr; gap: var(--s-3); padding-top: var(--s-3); border-top: 1px solid var(--rule); }
  .case__meta dt { font-weight: 620; }

  .case__hero { background: var(--bg); color: var(--fg); }
  .case__hero--bleed :global(.fig__media) { aspect-ratio: auto; height: min(88svh, 60rem); }
  .case__hero--bleed .cap { padding-bottom: var(--s-7); }
  .case__hero--piece { padding-block: clamp(2rem, 6vw, 6rem); }
  .case__hero--piece :global(.fig) { max-width: min(100%, calc(80svh * var(--r))); margin-inline: auto; }

  .case__credits { background: var(--bg); color: var(--fg); padding-block: var(--s-8); font-size: var(--t-small); }
  .case__credits ul { margin-top: var(--s-3); display: grid; gap: var(--s-1); }

  .next { background: var(--nf); color: var(--ni); }
  .next__link { display: block; padding-block: clamp(3rem, 8vw, 7rem); text-decoration: none; }
  .next__label { display: block; font-weight: 600; margin-bottom: var(--s-4); }
  .next__title { display: inline-block; white-space: nowrap; font-size: calc(var(--t-display) * var(--k, 1)); font-weight: 800; line-height: 0.86; letter-spacing: -0.025em; }
  .next__title span { display: block; }
  .next__link:hover .next__label { text-decoration: underline; text-decoration-thickness: 2px; text-underline-offset: 0.2em; }
  .next ::selection { background: var(--ni); color: var(--nf); }
  .next :focus-visible { outline-color: var(--ni); }

  @media (max-width: 1099px) {
    .case__intro { grid-template-columns: 1fr; }
  }
</style>
