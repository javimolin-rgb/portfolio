---
import Base from '../layouts/Base.astro';
import FormatFrame from '../components/FormatFrame.astro';
import ProjectIndex from '../components/ProjectIndex.astro';
import { url } from '../lib/assets';

---
<Base
  title="Javi Molin — Diseñadora Integral UC"
  description="Portfolio de María Javiera Molin, Diseñadora Integral UC. Dirección de arte, campañas, eventos y piezas que funcionan en todos los formatos, del lienzo de cinco metros al mensaje de WhatsApp."
  current="inicio"
>
  <FormatFrame />
  <ProjectIndex />

  <section class="about" aria-labelledby="about-title">
    <h2 id="about-title" class="about__title h2">Pienso cada campaña como un sistema.</h2>
    <div class="about__body prose">
      <p>Soy Javi Molin, Diseñadora Integral de la Pontificia Universidad Católica de Chile, con foco en diseño gráfico y branding. En 2025 fui diseñadora de marketing en Ripley: campañas, eventos y activaciones para Chile y Perú, junto a Marketing, Contenidos y Comercial, y con agencias y productoras.</p>
      <p>Me interesa la parte que no se ve en la pieza final: medir, adaptar a veinte formatos, revisar el legal y cerrar originales para que la imprenta no tenga dudas.</p>
      <div class="actions about__actions"><a class="btn btn--ghost" href={url('sobre-mi/')}>Ver experiencia y formación</a></div>
    </div>
  </section>
</Base>

<style>
  .about { margin: var(--section) var(--margin) 0; display: grid; grid-template-columns: minmax(0, 7fr) minmax(0, 5fr); gap: var(--s-5) var(--gap); align-items: start; padding-top: var(--s-7); border-top: 1px solid var(--rule); }
  .about__actions { margin-top: var(--s-5); }
  @media (max-width: 899px) { .about { grid-template-columns: 1fr; } }
</style>
